# ESMF #
logKindFlag:            @[esmf_logkind]
globalResourceControl:  @[ESMF_THREADING]

# EARTH #
EARTH_component_list: ATM CHM CECE
EARTH_attributes::
  Verbosity = 0
::

# ATM #
ATM_model:                      @[atm_model]
ATM_petlist_bounds:             @[atm_petlist_bounds]
ATM_omp_num_threads:            @[atm_omp_num_threads]
ATM_attributes::
  Verbosity = 0
::

# CHM #
CHM_model:                      @[chm_model]
CHM_petlist_bounds:             @[chm_petlist_bounds]
CHM_omp_num_threads:            @[chm_omp_num_threads]
CHM_attributes::
  Verbosity = 0
::

# CECE #
CECE_model:                     @[cece_model]
CECE_petlist_bounds:            @[cece_petlist_bounds]
CECE_omp_num_threads:           @[cece_omp_num_threads]
CECE_attributes::
  Verbosity = 0
::

# Run Sequence #
runSeq::
  @@[coupling_interval_sec]
    ATM phase1
    CECE
    ATM -> CHM
    CECE -> CHM
    CHM
    CHM -> ATM
    ATM phase2
  @
::
